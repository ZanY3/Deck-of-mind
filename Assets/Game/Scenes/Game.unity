  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fc87296b79219b64f8c85601e66726f2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EndingManager
  textField: {fileID: 896052516}
  slideImage: {fileID: 1998874536}
  canvasGroup: {fileID: 400765829}
  fadeImage: {fileID: 348172275}
  sentencesOnEnglish:
  - The Mind has fallen. The fight is done.
  - Its shadow fades beneath the sun.
  - But you stood strong, you didn't fall.
  - You took back control, you claimed it all.
  - The Mind is silent. The storm is gone.
  - You leave this place, but carry on.
  sentencesOnRussian:
  - "\u0420\u0430\u0437\u0443\u043C \u043F\u0430\u043B. \u041E\u043A\u043E\u043D\u0447\u0435\u043D
    \u0431\u043E\u0439"
  - "\u0415\u0433\u043E \u0442\u0435\u043D\u044C \u043F\u043E\u0434 \u0441\u043E\u043B\u043D\u0446\u0435\u043C
    \u0442\u0430\u0435\u0442, \u0441\u043B\u043E\u0432\u043D\u043E \u0441\u043E\u043D."
  - "\u041D\u043E \u0442\u044B \u0432\u0441\u0451 \u0441\u043C\u043E\u0433, \u0442\u044B
    \u043D\u0435 \u0443\u043F\u0430\u043B."
  - "\u0422\u044B \u0432\u0437\u044F\u043B \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C
    - \u0438 \u0432\u0441\u0451 \u0432\u0435\u0440\u043D\u0443\u043B."
  - "\u0422\u0435\u043F\u0435\u0440\u044C \u043E\u043D \u0442\u0438\u0445. \u0418
    \u0431\u0443\u0440\u044F \u0441\u0442\u0438\u0445\u043B\u0430 \u0432\u043C\u0435\u0441\u0442\u0435
    \u0441 \u043D\u0438\u043C.."
  - "\u0422\u044B \u043F\u043E\u043A\u0438\u0434\u0430\u0435\u0448\u044C \u044D\u0442\u043E
    \u043C\u0435\u0441\u0442\u043E, \u043D\u043E \u0436\u0438\u0437\u043D\u044C \u0437\u0432\u0430\u043B\u0430."
  images:
  - {fileID: -855298285791758126, guid: 8295f0c53c182a3488915069d75c8de3, type: 3}
  - {fileID: 6937817954938267909, guid: 47e8822a539470d45a755be2f9292feb, type: 3}
